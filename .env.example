# Variables de entorno de VISION MCP
# Copiar este archivo a .env y ajustar los valores según tu entorno

# Modo de debug (true/false)
# VISION_DEBUG=false

# Puerto para transporte SSE (si se usa HTTP en lugar de stdio)
# PORT=8000

# Intervalo de auto-commit en minutos
# AUTO_COMMIT_INTERVAL_MINUTES=30
